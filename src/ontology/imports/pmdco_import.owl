SubClassOf(<https://w3id.org/pmd/co/PMD_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000312> <https://w3id.org/pmd/co/PMD_0000833>))

# Class: <https://w3id.org/pmd/co/PMD_0000005> (Materialeigenschaft)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000005> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000005> "Materialeigenschaft"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000005> "material performance property"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000005> "a disposition of a portion of matter that is realized in a compatible process and whose realization is grounded in the portions intensive qualities"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0000005> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000005> <https://w3id.org/pmd/co/PMD_0020353>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000005> <https://w3id.org/pmd/co/PMD_0023004>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000005> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000056> <http://purl.obolibrary.org/obo/BFO_0000015>))))

# Class: <https://w3id.org/pmd/co/PMD_0000008> (process attribute)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000008> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0000008> "an attribute of a process")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000008> "process attribute"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0000008> "process characteristic"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000008> "a process attribute is a dependent occurrent that existentially depends on a process."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0000008> "Tensile rate in a tensile testing process. Cooling rate in a quenching process"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0000008> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000008> <http://purl.obolibrary.org/obo/BFO_0000003>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000008> ObjectSomeValuesFrom(<https://w3id.org/pmd/co/PMD_0025006> <http://purl.obolibrary.org/obo/BFO_0000015>))

# Class: <https://w3id.org/pmd/co/PMD_0000054> (heating function)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000054> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000054> "Heizfunktion"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000054> "heating function"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000054> "A temperature change function that, when realized, enables a system or device to increase the thermal energy of a material, typically to reach temperatures required for processing, transformation, or reaction."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000054> "Eine Heizfunktion ist eine (realisierbare) Funktion, die ein System oder Gerät in die Lage versetzt, die Wärmeenergie eines Materials zu erhöhen, um die für die Verarbeitung, Umwandlung oder Reaktion erforderlichen Temperaturen zu erreichen."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0000054> "The function of a resistance heater in a vacuum furnace."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000054> <https://w3id.org/pmd/co/PMD_0000969>)

# Class: <https://w3id.org/pmd/co/PMD_0000055> (Kühlfunktion)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000055> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000055> "Kühlfunktion"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000055> "cooling function"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000055> "A temperature change function that enables a system or device to lower the temperature of a material, often to control solidification or maintain a stable state below a desired thermal threshold."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000055> "Eine Kühlfunktion ist eine (realisierbare) Funktion, die es einem System oder Gerät ermöglicht, die Temperatur eines Materials zu senken, häufig um die Erstarrung zu steuern oder einen stabilen Zustand unterhalb eines gewünschten thermischen Schwellenwerts aufrechtzuerhalten."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0000055> "The function of a water-cooled mold to solidify molten metal in casting."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000055> <https://w3id.org/pmd/co/PMD_0000969>)

# Class: <https://w3id.org/pmd/co/PMD_0000056> (melting furnace)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000056> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000056> "Schmelzofen"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000056> "melting furnace"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000056> "A melting furnace is a device that bears a melting function, typically designed to raise the temperature of a solid material to initiate and sustain its transformation into a melt."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000056> "Ein Schmelzofen ist ein Gerät, das eine Schmelzfunktion hat und in der Regel dazu dient, die Temperatur eines festen Materials zu erhöhen, um seine Umwandlung in eine Schmelze einzuleiten und aufrechtzuerhalten."@de)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000056> <https://w3id.org/pmd/co/PMD_0000780>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000056> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0000655> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000085> <https://w3id.org/pmd/co/PMD_0000057>)))

# Class: <https://w3id.org/pmd/co/PMD_0000057> (Schmelzfunktion)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000057> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000057> "Schmelzfunktion"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000057> "melting function"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000057> "A heating function that, when realized, enables a device or system to initiate or sustain the phase transition of a solid material into a liquid by raising its temperature above the melting point."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000057> "Eine Schmelzfunktion ist eine Heizfunktion, die es einem Gerät oder System ermöglicht, den Phasenübergang eines festen Materials in eine Flüssigkeit einzuleiten oder aufrechtzuerhalten, indem seine Temperatur über den Schmelzpunkt angehoben wird."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0000057> "The function of an induction coil in a furnace to heat metal until it melts."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000057> <https://w3id.org/pmd/co/PMD_0000054>)

# Class: <https://w3id.org/pmd/co/PMD_0000103> (hardening)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000103> "hardening"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0000103> "toughening")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000103> "A manufacturing process that increases the strength and hardness of a material."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000103> <https://w3id.org/pmd/co/PMD_0000833>)

# Class: <https://w3id.org/pmd/co/PMD_0000520> (heat flow)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000520> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000520> "Wärmefluss"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000520> "heat flow"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000520> "is a process in which transfer of thermal energy between or within material entities occurs"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000520> "ist ein Prozess, bei dem Wärmeenergie zwischen oder innerhalb materieller Einheiten übertragen wird"@de)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000520> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Class: <https://w3id.org/pmd/co/PMD_0000549> (change of temperature)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000549> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000549> "Temperaturänderung"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000549> "change of temperature"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000549> "Temperaturänderung ist ein Prozess, bei dem ein Teilnehmer seine Temperatur ändert"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000549> "change of temperature is a process in which a particpant changes its temperature"@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0000549> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000549> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Class: <https://w3id.org/pmd/co/PMD_0000550> (changing properties of material)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000550> "Stoffeigenschaft Ändern"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000550> "changing properties of material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0000550> "Changing Of Material  Properties"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0000550> "Property Alteration"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000550> "A manufacturing process that modifies the characteristics of the material from which a workpiece is made, including by processes at the submicroscopic or atomic scale, such as atomic diffusion, dislocation formation and movement in the atomic lattice or chemical reactions, whereby the resulting shape changes are not characteristic of these processes."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000550> "Ein Herstellungsprozess, der die Merkmale des Materials, aus dem ein Werkstück gefertigt ist, modifiziert, was unter anderem durch Vorgänge im submikroskopischen oder atomaren Bereich erfolgt, wie etwa durch Atomdiffusion, die Versetzungsentstehung und -bewegung im Atomgitter oder durch chemische Reaktionen, wobei die dabei auftretenden Formveränderungen nicht charakteristisch für diese Verfahren sind."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0000550> "Heat Treatment"@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000550> <https://w3id.org/pmd/co/PMD_0000833>)

# Class: <https://w3id.org/pmd/co/PMD_0000553> (chemisches Potential)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000553> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000553> "chemical potential"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000553> "chemisches Potential"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000553> "a quality of a thermodynamic system describing the energy change associated with the addition of a small quantity of a substance to a system at constant temperature and pressure."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000553> "eine intensive Qualität eines thermodynamischen Systems, die die Energieänderung beschreibt, die mit der Zugabe einer kleinen Menge einer Substanz zu einem System bei konstanter Temperatur und konstantem Druck verbunden ist."@de)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0000553> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000553> <https://w3id.org/pmd/co/PMD_0080116>)

# Class: <https://w3id.org/pmd/co/PMD_0000597> (mass density)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000597> "mass density"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000597> "fundamental property of matter representing the mass of a portion of matter per unit volume"@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000597> <https://w3id.org/pmd/co/PMD_0023043>)

# Class: <https://w3id.org/pmd/co/PMD_0000602> (device)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000602> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000602> "Gerät"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000602> "device"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000602> "A device is an object that is designed to perform a specific function or task involving measurement, manipulation, processing, or analysis."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000602> "Ein physisches oder virtuelles Objekt, das verwendet wird, um eine bestimmte Funktion oder Aufgabe auszuführen, häufig im Zusammenhang mit der Messung, Manipulation oder Analyse von Materialien."@de)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0000602> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000602> <http://purl.obolibrary.org/obo/BFO_0000030>)

# Class: <https://w3id.org/pmd/co/PMD_0000619> (electric potential)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000619> "electric potential"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000619> "an extensvie quality describing the amount of work needed to move a unit charge from a reference point to a specific location in an electric field."@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000619> <https://w3id.org/pmd/co/PMD_0080116>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000619> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002328> <https://w3id.org/pmd/co/PMD_0080022>))

# Class: <https://w3id.org/pmd/co/PMD_0000654> (functional material)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <https://w3id.org/pmd/co/PMD_0000654> "Classified by the role in a system."@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000654> "functional material"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000654> "A functional material F is a material which has the function to be used for an object O (O consists of F) and O's function is other/more than mechanical load carrying."@en)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0000654> "true"^^xsd:boolean)
EquivalentClasses(<https://w3id.org/pmd/co/PMD_0000654> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0000000> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000030> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000085> <http://purl.obolibrary.org/obo/BFO_0000034>)))))
SubClassOf(<https://w3id.org/pmd/co/PMD_0000654> <https://w3id.org/pmd/co/PMD_0000000>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000654> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000030> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000085> <http://purl.obolibrary.org/obo/BFO_0000034>))))

# Class: <https://w3id.org/pmd/co/PMD_0000655> (Ofen)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000655> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000655> "Ofen"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000655> "furnace"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000655> "A device that generates and contains high-intensity thermal energy within an insulated enclosure."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000655> "Ein Gerät, das hochintensive thermische Energie innerhalb eines isolierten Gehäuses erzeugt und speichert."@de)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000655> <https://w3id.org/pmd/co/PMD_0000602>)

# Class: <https://w3id.org/pmd/co/PMD_0000779> (Wärmebehandlung)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000779> "Wärmebehandlung"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000779> "heat treatment"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <https://w3id.org/pmd/co/PMD_0000779> "Wärmebehandeln"@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000779> "A changing properties of material process in which a solid (ferrous) product is fully or partially exposed to specific time-temperature sequences through a series of process steps with the aim of modifying its properties and/or its internal structure."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000779> "Ein Stoffeigenschaft Ändern Prozess, bei dem durch eine Reihe von Verfahrensschritten ein festes (Eisen-)Produkt ganz oder teilweise bestimmten Zeit-Temperatur-Abfolgen ausgesetzt wird, mit dem Ziel, seine Eigenschaften und/oder seine innere Struktur zu modifizieren."@de)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/pmd/co/PMD_0000779> "Annealing, Ageing, Hardening"@en)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000779> <https://w3id.org/pmd/co/PMD_0000550>)

# Class: <https://w3id.org/pmd/co/PMD_0000780> (Wärmebehandlungsgerät)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000780> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000780> "Wärmebehandlungsgerät"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000780> "heat treatment device"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000780> "A device used for treating materials through heating and cooling processes to alter their properties."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000780> "Ein Gerät zur Behandlung von Materialien durch Erwärmungs- und Abkühlungsprozesse zur Veränderung ihrer Eigenschaften."@de)
EquivalentClasses(<https://w3id.org/pmd/co/PMD_0000780> ObjectIntersectionOf(<https://w3id.org/pmd/co/PMD_0000602> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000085> ObjectUnionOf(<https://w3id.org/pmd/co/PMD_0000054> <https://w3id.org/pmd/co/PMD_0000055>))))
SubClassOf(<https://w3id.org/pmd/co/PMD_0000780> <https://w3id.org/pmd/co/PMD_0000602>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000780> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000085> ObjectUnionOf(<https://w3id.org/pmd/co/PMD_0000054> <https://w3id.org/pmd/co/PMD_0000055>)))

# Class: <https://w3id.org/pmd/co/PMD_0000781> (heat treatment function)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000781> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000781> "Wärmebehandlungsfunktion"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000781> "heat treatment function"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000781> "A function performed to alter the properties of materials through controlled heating and cooling processes."@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <https://w3id.org/pmd/co/PMD_0000781> "Eine Funktion, die durchgeführt wird, um die Eigenschaften von Materialien durch kontrollierte Wärme- und Abkühlungsprozesse zu verändern."@de)
AnnotationAssertion(<https://w3id.org/pmd/co/PMD_0000060> <https://w3id.org/pmd/co/PMD_0000781> "true"^^xsd:boolean)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000781> <http://purl.obolibrary.org/obo/BFO_0000034>)
SubClassOf(<https://w3id.org/pmd/co/PMD_0000781> <https://w3id.org/pmd/co/PMD_0020317>)
